# Copia este archivo como modelo/.env y llena los valores. El .env NO se sube a git.

# --- Correo (recuperación de contraseña) con Gmail ---
# 1) Activa la verificación en 2 pasos en tu cuenta de Google.
# 2) Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# 3) Pégala aquí (con o sin espacios). NO uses tu contraseña normal de Gmail.
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Opcionales ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=Baymax <tucuenta@gmail.com>
# FRONTEND_URL=http://localhost:5173
# DATABASE_URL=postgresql://postgres@localhost/baymax
# JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
